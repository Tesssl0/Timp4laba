# Скопируйте этот файл в .env и при необходимости поменяйте значения:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1594826
POSTGRES_DB=mediaguard

# --- Backend ---
JWT_SECRET=MediaGuardSecretKey
BACKEND_PORT=5000

# --- Frontend ---
FRONTEND_PORT=3000
# Адрес API, который увидит браузер. Если открываете демо не с
# localhost (например, с IP преподавательской машины), поменяйте
# на http://<адрес-сервера>:5000/api
VITE_API_URL=http://localhost:5000/api
# Разрешённый источник для CORS на бэкенде — должен совпадать с адресом,
# по которому преподаватель будет открывать фронтенд в браузере
CORS_ORIGIN=http://localhost:3000
