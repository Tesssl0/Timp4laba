PORT=5000

# --- Локальная разработка / docker-compose ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=1594826
DB_NAME=mediaguard

# --- Продакшн на Render ---
# Создайте Render PostgreSQL и скопируйте его "Internal Database URL"
# в переменную DATABASE_URL на вашем Web Service. Если задана DATABASE_URL,
# db.js будет использовать её вместо DB_HOST/DB_PORT/... и включит SSL.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_SSL=true   # включить SSL, если подключаетесь по DB_HOST/... к управляемой БД

JWT_SECRET=MediaGuardSecretKey

# Локально — фронтенд на Vite (5173) и/или Docker (3000).
# На проде — реальный домен фронтенда, например:
# CORS_ORIGIN=https://timp4laba-frontend.onrender.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
